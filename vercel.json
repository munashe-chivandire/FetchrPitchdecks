{
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    { "source": "/Deck2/Fetchr_Enterprise_Deck(.*)", "destination": "/Deck2/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
